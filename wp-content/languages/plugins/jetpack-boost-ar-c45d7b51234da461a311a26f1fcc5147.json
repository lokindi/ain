(opens in a new tab)":["(\u062a\u0641\u062a\u062d \u0641\u064a \u0639\u0644\u0627\u0645\u0629 \u062a\u0628\u0648\u064a\u0628 \u062c\u062f\u064a\u062f\u0629)"],"Error requesting speed scores":["\u062e\u0637\u0623 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u0637\u0644\u0628 \u0646\u0642\u0627\u0637 \u0627\u0644\u0633\u0631\u0639\u0629"],"Failed to load performance history":["\u0641\u0634\u0644 \u062a\u062d\u0645\u064a\u0644 \u0645\u062d\u0641\u0648\u0638\u0627\u062a \u0627\u0644\u0623\u062f\u0627\u0621"],"Desktop":["\u0633\u0637\u062d \u0627\u0644\u0645\u0643\u062a\u0628"],"Cumulative Layout Shift":["\u0627\u0644\u062a\u062d\u0648\u0651\u064f\u0644 \u0641\u064a \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u062a\u0631\u0627\u0643\u0645\u064a"],"Total Blocking Time":["\u0625\u062c\u0645\u0627\u0644\u064a \u0648\u0642\u062a \u0627\u0644\u062d\u0638\u0631"],"Largest Contentful Paint":["\u0645\u062f\u0629 \u0639\u0631\u0636 \u0623\u0643\u0628\u0631 \u062c\u0632\u0621 \u0645\u0646 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629"],"Overall score":["\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0646\u0642\u0627\u0637"],"Close":["\u0625\u063a\u0644\u0627\u0642"],"Read the guide":["\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u062f\u0644\u064a\u0644"],"Upgrade now":["\u0642\u0645 \u0628\u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0627\u0644\u0622\u0646"],"Your site got faster":["\u0623\u0635\u0628\u062d \u0645\u0648\u0642\u0639\u0643 \u0623\u0633\u0631\u0639"],"Speed score has fallen":["\u0627\u0646\u062e\u0641\u0627\u0636 \u0646\u0642\u0627\u0637 \u0627\u0644\u0633\u0631\u0639\u0629"],"That's great! If you\u2019re happy, why not rate Boost?":["\u0647\u0630\u0627 \u0631\u0627\u0626\u0639! \u0625\u0630\u0627 \u0643\u0646\u062a \u0633\u0639\u064a\u062f\u064b\u0627\u060c \u0641\u0644\u0645\u064e \u0644\u0627 \u062a\u0642\u0645 \u0628\u062a\u0642\u064a\u064a\u0645 Boost\u061f"],"Jetpack Logo":["\u0634\u0639\u0627\u0631 Jetpack"],"An Automattic Airline":["\u0634\u0631\u0643\u0629 \u0623\u0648\u062a\u0648\u0645\u0627\u062a\u064a\u0643 \u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u062f\u0648\u064a\u0646"],"Jetpack":["Jetpack"],"Rate the Plugin":["\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0625\u0636\u0627\u0641\u0629"],"An error occurred while trying to communicate with the site REST API. Extra debug info: %s":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u062a\u0637\u0628\u064a\u0642\u0627\u062a REST \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0645\u0648\u0642\u0639. \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u0635\u062d\u064a\u062d \u0627\u0644\u0625\u0636\u0627\u0641\u064a: %s"],"Dismiss":["\u062a\u062c\u0627\u0647\u0644"],"Loading\u2026":["\u062c\u0627\u0631\u064a \u0627\u0644\u062a\u062d\u0645\u064a\u0644\u2026"],"Timed out while waiting for speed-score.":["\u0627\u0646\u062a\u0647\u062a \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0632\u0645\u0646\u064a\u0629 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u062c\u0645\u0648\u0639 \u0646\u0642\u0627\u0637 \u0627\u0644\u0633\u0631\u0639\u0629."],"An unknown error occurred while requesting metrics":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0645\u062c\u0647\u0648\u0644 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u0637\u0644\u0628 \u0627\u0644\u0645\u0642\u0627\u064a\u064a\u0633"],"Your site's REST API does not seem to be accessible. Jetpack Boost requires access to your REST API in order to receive site performance scores. Please make sure that your site's REST API is active and accessible, and try again.":["\u0644\u0627 \u064a\u0628\u062f\u0648 \u0623\u0646 \u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u062a\u0637\u0628\u064a\u0642\u0627\u062a REST \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0645\u0648\u0642\u0639\u0643 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0648\u0635\u0648\u0644. \u064a\u062a\u0637\u0644\u0628 Jetpack Boost \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0648\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u062a\u0637\u0628\u064a\u0642\u0627\u062a REST \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0645\u0646 \u0623\u062c\u0644 \u062a\u0644\u0642\u064a \u0645\u062c\u0627\u0645\u064a\u0639 \u0646\u0642\u0627\u0637 \u0627\u0644\u0623\u062f\u0627\u0621 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0645\u0648\u0642\u0639. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u062a\u0637\u0628\u064a\u0642\u0627\u062a REST \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0645\u0648\u0642\u0639\u0643 \u0646\u0634\u0637\u0629 \u0648\u064a\u0645\u0643\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064a\u0647\u0627\u060c \u0648\u062d\u0627\u0648\u0644 \u0645\u062c\u062f\u062f\u064b\u0627."],"Invalid response while requesting metrics":["\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u0637\u0644\u0628 \u0627\u0644\u0645\u0642\u0627\u064a\u064a\u0633"],"Received invalid response while communicating with your WordPress site: %s":["\u062a\u0645 \u062a\u0644\u0642\u064a \u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0645\u0648\u0642\u0639\u0643 \u0639\u0644\u0649 \u0648\u0648\u0631\u062f\u0628\u0631\u064a\u0633: %s"],"HTTP %d error received while communicating with the server.":["\u062a\u0645 \u062a\u0644\u0642\u064a \u062e\u0637\u0623 \u0641\u064a HTTP %d \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0627\u062a\u0635\