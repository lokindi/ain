u0631\u0643\u0629 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"You can see stats from all shared Google services, but you can't make any changes. <a>Learn more<\/a>":["\u064a\u0645\u0643\u0646\u0643 \u0631\u0624\u064a\u0629 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0645\u0646 \u062c\u0645\u064a\u0639 \u062e\u062f\u0645\u0627\u062a Google \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629\u060c \u0644\u0643\u0646 \u0644\u0627 \u064a\u0645\u0643\u0646\u0643 \u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a. <a>\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u062f<\/a>"],"You can see stats from all shared Google services, but you can't make any changes. Sign in to connect more services and control sharing access.":["\u064a\u0645\u0643\u0646\u0643 \u0631\u0624\u064a\u0629 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0645\u0646 \u062c\u0645\u064a\u0639 \u062e\u062f\u0645\u0627\u062a Google \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629\u060c \u0644\u0643\u0646 \u0644\u0627 \u064a\u0645\u0643\u0646\u0643 \u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a. \u0633\u062c\u0651\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0631\u0628\u0637 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u062d\u0643\u0651\u0645 \u0641\u064a \u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629."],"View only":["\u0639\u0631\u0636 \u0641\u0642\u0637"],"Proceed without enabling auto ads":["\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u062f\u0648\u0646 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629"],"Site Kit recommends enabling auto ads. If your existing AdSense setup relies on individual ad units, you can proceed without enabling auto ads.":["\u064a\u0646\u0635\u062d Site Kit \u0628\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0625\u0639\u062f\u0627\u062f AdSense \u0627\u0644\u062d\u0627\u0644\u064a \u0644\u062f\u064a\u0643 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0648\u062d\u062f\u0627\u062a \u0625\u0639\u0644\u0627\u0646\u064a\u0629 \u0641\u0631\u062f\u064a\u0629\u060c \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u062f\u0648\u0646 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629."],"Enable auto ads":["\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629"],"To start serving ads via Site Kit, you need to activate auto ads first. Go to AdSense and enable auto ads for your site.":["\u0644\u0628\u062f\u0621 \u0639\u0631\u0636 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0639\u0628\u0631 Site Kit\u060c \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0623\u0648\u0644\u0627. \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 AdSense \u0648\u0641\u0639\u0651\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0644\u0645\u0648\u0642\u0639\u0643."],"Enable auto ads for your site":["\u0641\u0639\u0651\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0644\u0645\u0648\u0642\u0639\u0643"],"Site Kit has placed AdSense code on your site to connect your site to AdSense and help you get the most out of ads":["\u0648\u0636\u0639 Site Kit \u0634\u0641\u0631\u0629 AdSense \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643 \u0644\u0631\u0628\u0637 \u0645\u0648\u0642\u0639\u0643 \u0628\u0640 AdSense \u0648\u0645\u0633\u0627\u0639\u062f\u062a\u0643 \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0627\u0644\u0642\u0635\u0648\u0649 \u0645\u0646 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a"],"Connect your AdSense account to see stats on your overall earnings, page CTR, and top earning pages":["\u0627\u0631\u0628\u0637 \u062d\u0633\u0627\u0628 AdSense \u0644\u062f\u064a\u0643 \u0644\u0631\u0624\u064a\u0629 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u062d\u0648\u0644 \u0625\u062c\u0645\u0627\u0644\u064a \u0623\u0631\u0628\u0627\u062d\u0643 \u0648\u0646\u0633\u0628\u0629 \u0627\u0644\u0646\u0642\u0631 \u0625\u0644\u0649 \u0627\u0644\u0638\u0647\u0648\u0631 \u0644\u0644\u0635\u0641\u062d\u0629 \u0648\u0623\u0628\u0631\u0632 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0631\u0628\u062d\u0627"],"Your site is ready to use AdSense":["\u0645\u0648\u0642\u0639\u0643 \u062c\u0627\u0647\u0632 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 AdSense"],"Your AdSense account is ready to connect to Site Kit":["\u062d\u0633\u0627\u0628 AdSense \u0644\u062f\u064a\u0643 \u062c\u0627\u0647\u0632 \u0644\u0644\u0631\u0628\u0637 \u0628\u0640 Site Kit"],"Request review in AdSense":["\u0637\u0644\u0628 \u0645\u0631\u0627\u062c\u0639\u0629 \u0641\u064a AdSense"],"To start serving ads, your site needs to be approved first. Go to AdSense to request the review.":["\u0644\u0628\u062f\u0621 \u0639\u0631\u0636 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a\u060c \u064a\u062c\u0628 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643 \u0623\u0648\u0644\u0627. \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 AdSense \u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629."],"Your site requires review":["\u0645\u0648\u0642\u0639\u0643 \u064a\u062a\u0637\u0644\u0651\u0628 \u0645\u0631\u0627\u062c\u0639\u0629"],"This usually takes a few days, but in some cases can take a few weeks. You\u2019ll get an email from AdSense as soon as they have run some checks on your site.":["\u064a\u0633\u062a\u063a\u0631\u0642 \u0647\u0630\u0627 \u0639\u0627\u062f\u0629 \u0628\u0636\u0639\u0629 \u0623\u064a\u0627\u0645\u060c \u0644\u0643\u0646\u0647 \u0642\u062f \u064a\u0633\u062a\u063a\u0631\u0642 \u0628\u0636\u0639\u0629 \u0623\u0633\u0627\u0628\u064a\u0639 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0644\u0627\u062a. \u0633\u062a\u0635\u0644\u0643 \u0631\u0633\u0627\u0644\u0629 \u0645\u0646 AdSense \u0628\u0645\u062c\u0631\u062f \u0625\u062c\u0631\u0627\u0626\u0647\u0645 \u0628\u0639\u0636 \u0627\u0644\u0641\u062d\u0648\u0635\u0627\u062a \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643."],"Your site is getting ready":["\u0645\u0648\u0642\u0639\u0643 \u064a\u0633\u062a\u0639\u062f\u0651"],"Review site in AdSense":["\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u0648\u0642\u0639 \u0641\u064a AdSense"],"You need to fix some things with this site before we can connect Site Kit to your AdSense account":["\u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0635\u0644\u0627\u062d \u0628\u0639\u0636 \u0627\u0644\u0623\u0645\u0648\u0631 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u0642\u0628\u0644 \u0623\u0646 \u0646\u062a\u0645\u0643\u0651\u0646 \u0645\u0646 \u0631\u0628\u0637 Site Kit \u0628\u062d\u0633\u0627\u0628 AdSense \u0644\u062f\u064a\u0643"],"Site Kit detected AdSense code for a different account %1$s on your site. In order to configure AdSense for your current account %2$s, we recommend you use Site Kit to place the code instead.":["\u0627\u0643\u062a\u0634\u0641 Site Kit \u0634\u0641\u0631\u0629 AdSense \u0644\u062d\u0633\u0627\u0628 \u0645\u062e\u062a\u0644\u0641 %1$s \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643. \u0644\u062a\u0643\u0648\u064a\u0646 AdSense \u0644\u062d\u0633\u0627\u0628\u0643 \u0627\u0644\u062d\u0627\u0644\u064a %2$s\u060c \u0646\u0646\u0635\u062d \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Site Kit \u0644\u0648\u0636\u0639 \u0627\u0644\u0634\u0641\u0631\u0629 \u0628\u062f\u0644\u0627 \u0645\u0646 \u0630\u0644\u0643."],"You\u2019ve already got an AdSense code on your site for this account. We recommend you use Site Kit to place the code to get the most out of AdSense.":["\u0644\u062f\u064a\u0643 \u0628\u0627\u0644\u0641\u0639\u0644 \u0634\u0641\u0631\u0629 AdSense \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643 \u0644\u0647\u0630\u0627 \u0627\u0644\u062d\u0633\u0627\u0628. \u0646\u0646\u0635\u062d \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Site Kit \u0644\u0648\u0636\u0639 \u0627\u0644\u0634\u0641\u0631\u0629 \u0644\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0627\u0644\u0642\u0635\u0648\u0649 \u0645\u0646 AdSense."],"Make sure to remove the existing AdSense code to avoid conflicts with the code placed by Site Kit":["\u062a\u0623\u0643\u0651\u062f \u0645\u0646 \u0625\u0632\u0627\u0644\u0629 \u0634\u0641\u0631\u0629 AdSense \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0644\u062a\u062c\u0646\u0651\u0628 \u0627\u0644\u062a\u0639\u0627\u0631\u0636 \u0645\u0639 \u0627\u0644\u0634\u0641\u0631\u0629 \u0627\u0644\u062a\u064a \u0648\u0636\u0639\u0647\u0627 Site Kit"],"Invalid site state %s":["\u062d\u0627\u0644\u0629 \u0645\u0648\u0642\u0639 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 %s"],"Go to dashboard":["\u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"Already use AdSense? Add %s as a user to an existing AdSense account. <a>Learn more<\/a>":["\u0647\u0644 \u062a\u0633\u062a\u062e\u062f\u0645 AdSense \u0628\u0627\u0644\u0641\u0639\u0644\u061f \u0623\u0636\u0641 %s \u0643\u0645\u0633\u062a\u062e\u062f\u0645 \u0625\u0644\u0649 \u062d\u0633\u0627\u0628 AdSense \u0645\u0648\u062c\u0648\u062f. <a>\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u062f<\/a>"],"Create AdS