u0628\u0639 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637\u0627\u062a \u0645\u0627 \u062f\u0627\u0645 \u0647\u0646\u0627\u0643 \u0645\u0644\u0641 robots.txt \u062b\u0627\u0628\u062a \u0645\u0648\u062c\u0648\u062f \u0641\u064a \u062f\u0644\u064a\u0644 \u062a\u062b\u0628\u064a\u062a \u0648\u0648\u0631\u062f\u0628\u0631\u064a\u0633."],"AI crawlers can't reach this site while it's closed to search engines.":["\u064a\u062a\u0639\u0630\u0651\u064e\u0631 \u0639\u0644\u0649 \u0645\u062a\u062a\u0628\u0639\u0627\u062a \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637\u0627\u062a \u0627\u0644\u0645\u062f\u0639\u0648\u0645\u0629 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u0637\u0627\u0644\u0645\u0627 \u0623\u0646\u0647 \u0645\u063a\u0644\u0642 \u0623\u0645\u0627\u0645 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b."],"AI crawlers can't reach this site while it's on a staging address.":["\u064a\u062a\u0639\u0630\u0651\u064e\u0631 \u0639\u0644\u0649 \u0645\u062a\u062a\u0628\u0639\u0627\u062a \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637\u0627\u062a \u0627\u0644\u0645\u062f\u0639\u0648\u0645\u0629 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u0623\u062b\u0646\u0627\u0621 \u0648\u062c\u0648\u062f\u0647 \u0639\u0644\u0649 \u0639\u0646\u0648\u0627\u0646 \u062a\u0634\u063a\u064a\u0644 \u0645\u0631\u062d\u0644\u064a."],"Get tools to optimize your site for improved search engine results.":["\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0644\u062a\u062d\u0633\u064a\u0646 \u0645\u0648\u0642\u0639\u0643 \u0628\u0647\u062f\u0641 \u062a\u0637\u0648\u064a\u0631 \u0646\u062a\u0627\u0626\u062c \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b."],"SEO title set":["\u0639\u0646\u0648\u0627\u0646 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b (SEO) \u0627\u0644\u0645\u0639\u064a\u0651\u064e\u0646"],"SEO tools help your content get found: customize titles and meta descriptions, generate a sitemap, verify your site with search engines, and control how pages look when shared. Turn it on to manage all of it from here.":["\u062a\u0633\u0627\u0639\u062f \u0623\u062f\u0648\u0627\u062a \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b (SEO) \u0639\u0644\u0649 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u062d\u062a\u0648\u0627\u0643: \u064a\u0645\u0643\u0646\u0643 \u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646 \u0648\u0627\u0644\u0623\u0648\u0635\u0627\u0641 \u0627\u0644\u062a\u0639\u0631\u064a\u0641\u064a\u0629\u060c \u0648\u0625\u0646\u0634\u0627\u0621 \u062e\u0631\u064a\u0637\u0629 \u0645\u0648\u0642\u0639\u060c \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0648\u0642\u0639\u0643 \u0644\u062f\u0649 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b\u060c \u0648\u0627\u0644\u062a\u062d\u0643\u0651\u064e\u0645 \u0641\u064a \u0643\u064a\u0641\u064a\u0629 \u0638\u0647\u0648\u0631 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0639\u0646\u062f \u0645\u0634\u0627\u0631\u0643\u062a\u0647\u0627. \u0642\u0645 \u0628\u062a\u0641\u0639\u064a\u0644 \u0630\u0644\u0643 \u0644\u0625\u062f\u0627\u0631\u0629 \u0643\u0644 \u0634\u064a\u0621 \u0645\u0646 \u0647\u0646\u0627."],"Enable SEO tools":["\u062a\u0645\u0643\u064a\u0646 \u0623\u062f\u0648\u0627\u062a \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b (SEO)"],"Could not disable SEO tools. Please try again.":["\u062a\u0639\u0630\u0651\u064e\u0631 \u062a\u0639\u0637\u064a\u0644 \u0623\u062f\u0648\u0627\u062a \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b (SEO). \u064a\u064f\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629."],"Could not enable SEO tools. Please try again.":["\u062a\u0639\u0630\u0651\u064e\u0631 \u062a\u0645\u0643\u064a\u0646 \u0623\u062f\u0648\u0627\u062a \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b (SEO). \u064a\u064f\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629."],"Make your site discoverable in search and social, and control AI access.":["\u0627\u062c\u0639\u0644 \u0645\u0648\u0642\u0639\u0643 \u0642\u0627\u0628\u0644\u0627\u064b \u0644\u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0641\u064a \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0648\u0634\u0628\u0643\u0627\u062a \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u060c \u0648\u062a\u062d\u0643\u0645 \u0641\u064a \u0648\u0635\u0648\u0644 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0625\u0644\u064a\u0647."],"GEO stands for generative engine optimization. These settings control how AI sees and uses your site.":["\u064a\u0631\u0645\u0632 \u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631 GEO \u0625\u0644\u0649 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u062a\u0648\u0644\u064a\u062f\u064a. \u062a\u062a\u062d\u0643\u0645 \u0647\u0630\u0647 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0641\u064a \u0643\u064a\u0641\u064a\u0629 \u0631\u0624\u064a\u0629 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0645\u0648\u0642\u0639\u0643 \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647 \u0644\u0647."],"What is GEO?":["\u0645\u0627 \u0627\u0644\u0645\u0642\u0635\u0648\u062f \u0628\u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u062a\u0648\u0644\u064a\u062f\u064a (GEO)\u061f"],"This is usually temporary. Give it another try.":["\u0639\u0627\u062f\u0629\u064b \u0645\u0627 \u064a\u0643\u0648\u0646 \u0647\u0630\u0627 \u0645\u0624\u0642\u062a\u064b\u0627. \u062d\u0627\u0648\u0644 \u0645\u062c\u062f\u062f\u064b\u0627."],"We couldn\u2019t load this page":["\u062a\u0639\u0630\u0651\u064e\u0631 \u0639\u0644\u064a\u0646\u0627 \u062a\u062d\u0645\u064a\u0644 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629"],"Set":["\u062a\u0639\u064a\u064a\u0646"],"Your tagline":["\u0634\u0639\u0627\u0631\u0643"],"Your site":["\u0645\u0648\u0642\u0639\u0643"],"Site name":["\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0642\u0639"],"SEO tools are not enabled on this site. Some cards reflect the underlying WordPress options only.":["\u0623\u062f\u0648\u0627\u062a \u0646\u0638\u0627\u0645 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b (SEO) \u063a\u064a\u0631 \u0645\u0641\u0639\u0651\u0644\u0629 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639. \u062a\u0639\u0643\u0633 \u0628\u0639\u0636 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u062e\u064a\u0627\u0631\u0627\u062a \u0648\u0648\u0631\u062f\u0628\u0631\u064a\u0633 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0641\u0642\u0637."],"Unable to load overview.":["\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0646\u0638\u0631\u0629 \u0639\u0627\u0645\u0629."],"Manage visibility":["\u0625\u062f\u0627\u0631\u0629 \u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u0648\u0642\u0639"],"Site visibility":["\u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u0648\u0642\u0639"],"Manage verification":["\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062a\u062d\u0642\u0642"],"Not set":["\u0644