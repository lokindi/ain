le track draft saved.":["\u062a\u0645 \u062d\u0641\u0638 \u0645\u0633\u0648\u062f\u0629 \u0645\u0633\u0627\u0631 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0631\u0639\u064a."],"Subtitle track published.":["\u062a\u0645 \u0646\u0634\u0631 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0631\u0639\u064a."],"Track error: %s":["\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0645\u0633\u0627\u0631: %s"],"Cancel replace":["\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0627\u0633\u062a\u0628\u062f\u0627\u0644"],"Accepted formats: %s":["\u0627\u0644\u062a\u0646\u0633\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u0642\u0628\u0648\u0644\u0629: %s"],"Select subtitle file":["\u062a\u062d\u062f\u064a\u062f \u0645\u0644\u0641 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0631\u0639\u064a"],"Replacing %s":["\u0627\u0633\u062a\u0628\u062f\u0627\u0644 %s"],"Replace track":["\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0645\u0633\u0627\u0631"],"Replace subtitle track":["\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0645\u0633\u0627\u0631 \u0639\u0646\u0648\u0627\u0646 \u0641\u0631\u0639\u064a"],"Upload subtitle track":["\u0631\u0641\u0639 \u0645\u0633\u0627\u0631 \u0639\u0646\u0648\u0627\u0646 \u0641\u0631\u0639\u064a"],"Replace file":["\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0645\u0644\u0641"],"Loading subtitle tracks\u2026":["\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0631\u0639\u064a\u2026"],"Subtitle track %s":["\u0645\u0633\u0627\u0631 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0631\u0639\u064a %s"],"A subtitle track already exists for that language. Use Replace file on the existing track to upload a new file.":["\u064a\u0648\u062c\u062f \u0628\u0627\u0644\u0641\u0639\u0644 \u0645\u0633\u0627\u0631 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u