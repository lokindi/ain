u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a.","\u062a\u0645 \u0646\u0642\u0644 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a.","\u062a\u0645 \u0646\u0642\u0644 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a."],"Moving %s response to trash\u2026":["\u062c\u0627\u0631\u064d \u0646\u0642\u0644 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a\u2026","\u062c\u0627\u0631\u064d \u0646\u0642\u0644 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a\u2026","\u062c\u0627\u0631\u064d \u0646\u0642\u0644 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a\u2026","\u062c\u0627\u0631\u064d \u0646\u0642\u0644 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a\u2026","\u062c\u0627\u0631\u064d \u0646\u0642\u0644 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a\u2026","\u062c\u0627\u0631\u064d \u0646\u0642\u0644 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f \u0625\u0644\u0649 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a\u2026"],"%s response restored.":["\u062a\u0645\u062a \u0627\u0633\u062a\u0639\u0627\u062f\u0629 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f.","\u062a\u0645\u062a \u0627\u0633\u062a\u0639\u0627\u062f\u0629 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f.","\u062a\u0645\u062a \u0627\u0633\u062a\u0639\u0627\u062f\u0629 %s \u0645\u0646 \u0627\u0644\u0631\u062f\u0648\u062f.","\u062a\u0645\u062a \u0627\u06