2c\u0648\u062c\u0644"],"Skip sign-in and view limited dashboard":["\u062a\u062e\u0637\u0651\u064a \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u0639\u0631\u0636 \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 \u0645\u062d\u062f\u0648\u062f\u0629"],"Shared services":["\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629"],"Learn more about dashboard sharing":["\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u062f \u062d\u0648\u0644 \u0645\u0634\u0627\u0631\u0643\u0629 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"You can see stats from all shared Google services, but you can't make any changes. <a>Learn more<\/a>":["\u064a\u0645\u0643\u0646\u0643 \u0631\u0624\u064a\u0629 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0645\u0646 \u062c\u0645\u064a\u0639 \u062e\u062f\u0645\u0627\u062a Google \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629\u060c \u0644\u0643\u0646 \u0644\u0627 \u064a\u0645\u0643\u0646\u0643 \u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a. <a>\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u062f<\/a>"],"You can see stats from all shared Google services, but you can't make any changes. Sign in to connect more services and control sharing access.":["\u064a\u0645\u0643\u0646\u0643 \u0631\u0624\u064a\u0629 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0645\u0646 \u062c\u0645\u064a\u0639 \u062e\u062f\u0645\u0627\u062a Google \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629\u060c \u0644\u0643\u0646 \u0644\u0627 \u064a\u0645\u0643\u0646\u0643 \u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a. \u0633\u062c\u0651\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0631\u0628\u0637 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u062d\u0643\u0651\u0645 \u0641\u064a \u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629."],"View only":["\u0639\u0631\u0636 \u0641\u0642\u0637"],"View-only Dashboard Access":["\u0648\u0635\u0648\u0644 \u0644\u0644\u0639\u0631\u0636 \u0641\u0642\u0637 \u0625\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"Go to dashboard":["\u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"Maybe later":["\u0631\u0628\u0645\u0627 \u0644\u0627\u062d\u0642\u0627"],"Back to dashboard":["\u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"Looks like Site Kit is unable to place or detect tags on your site. This can be caused by using certain caching or maintenance mode plugins or your site\u2019s frontend is configured on a different host or infrastructure than your administration dashboard. <GetHelpLink \/>":["\u064a\u0628\u062f\u0648 \u0623\u0646 Site Kit \u063a\u064a\u0631 \u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u0648\u0636\u0639 \u0627\u0644\u0648\u0633\u0648\u0645 \u0623\u0648 \u0627\u0643\u062a\u0634\u0627\u0641\u0647\u0627 \u0641\u064a \u0645\u0648\u0642\u0639\u0643. \u0642\u062f \u064a\u0643\u0648\u0646 \u0633\u0628\u0628 \u0630\u0644\u0643 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0625\u0636\u0627\u0641\u0627\u062a \u0645\u0639\u064a\u0651\u0646\u0629 \u0644\u0644\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0645\u0624\u0642\u062a \u0623\u0648 \u0648\u0636\u0639 \u0627\u0644\u0635\u064a\u0627\u0646\u0629\u060c \u0623\u0648 \u0623\u0646 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0644\u0645\u0648\u0642\u0639\u0643 \u0645\u0643\u0648\u0651\u0646\u0629 \u0639\u0644\u0649 \u0645\u0636\u064a\u0641 \u0623\u0648 \u0628\u0646\u064a\u0629 \u062a\u062d\u062a\u064a\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u0639\u0646 \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 \u0627\u0644\u0625\u062f\u0627\u0631\u0629. <GetHelpLink \/>"],"New URL: %s":["\u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062c\u062f\u064a\u062f: %s"],"Old URL: %s":["\u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u0642\u062f\u064a\u0645: %s"],"Monetization":["\u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0631\u0628\u062d"],"Content":["\u0627\u0644\u0645\u062d\u062a\u0648\u0649"],"Traffic":["\u0627\u0644\u0632\u064a\u0627\u0631\u0627\u062a"],"Get insights on how people find your site, as well as how to improve and monetize your site\u2019s content, directly in your WordPress dashboard":["\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u062d\u0648\u0644 \u0643\u064a\u0641\u064a\u0629 \u0639\u062b\u0648\u0631 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643\u060c \u0648\u0643\u0630\u0644\u0643 \u0643\u064a\u0641\u064a\u0629 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u062a\u0648\u0649 \u0645\u0648\u0642\u0639\u0643 \u0648\u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0631\u0628\u062d \u0645\u0646\u0647\u060c \u0645\u0628\u0627\u0634\u0631\u0629 \u0641\u064a \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 WordPress"],"screen reader text\u0004(disabled)":["(\u0645\u0639\u0637\u0651\u0644)"],"Help":["\u0645\u0633\u0627\u0639\u062f\u0629"],"<span>All collected data is treated in accordance with the <a>Google Privacy Policy<\/a><\/span>":["<span>\u062a\u064f\u0639\u0627\u0645\u064e\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0641\u0642\u0627 \u0644\u0640 <a>\u0633\u064a\u0627\u0633\u0629 \u062e\u0635\u0648\u0635\u064a\u0629 Google<\/a><\/span>"],"Help us improve Site Kit by sharing anonymous usage data.":["\u0633\u0627\u0639\u062f\u0646\u0627 \u0641\u064a \u062a\u062d\u0633\u064a\u0646 Site Kit \u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u062c\u0647\u0648\u0644\u0629 \u0627\u0644\u0645\u0635\u062f\u0631."],"Site Kit cannot access the WordPress REST API. Please ensure it is enabled on your site. <GetHelpLink \/>":["\u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 Site Kit \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 WordPress REST API. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0623\u0643\u0651\u062f \u0645\u0646 \u062a\u0641\u0639\u064a\u0644\u0647\u0627 \u0641\u064a \u0645\u0648\u0642\u0639\u0643. <GetHelpLink \/>"],"Get help with AdSense":["\u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0628\u062e\u0635\u0648\u0635 AdSense"],"Get support":["\u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u062f\u0639\u0645"],"Read help docs":["\u0642\u0631\u0627\u0621\u0629 \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629"],"Fix common issues":["\u0625\u0635\u0644\u0627\u062d \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a \u0627\u0644\u0634\u0627\u0626\u0639\u0629"],"Got it":["\u0641\u0647\u0645\u062a"],"%dh":["%d\u0633"],"%dm":["%d\u062f"],"%ds":["%d\u062b"],"duration of time: hh mm ss\u0004%3$s %2$s %1$s":["%3$s %2$s %1$s"],"Next":["\u0627\u0644\u062a\u0627\u0644\u064a"],"Get insights about how people find and use your site as well as how to improve and monetize your content, directly in your WordPress dashboard":["\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u062d\u0648\u0644 \u0643\u064a\u0641\u064a\u0629 \u0639\u062b\u0648\u0631 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643 \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0645 \u0644\u0647\u060c \u0648\u0643\u0630\u0644\u0643 \u0643\u064a\u0641\u064a\u0629 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u062a\u0648\u0627\u0643 \u0648\u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0631\u0628\u062d \u0645\u0646\u0647\u060c \u0645\u0628\u0627\u0634\u0631\u0629 \u0641\u064a \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 WordPress"],"Set up Site Kit":["\u0625\u0639\u062f\u0627\u062f Site Kit"],"Learn how":["\u062a\u0639\u0644\u0651\u0645 \u0643\u064a\u0641"],"Learn how to install and use the helper plugin":["\u062a\u0639\u0644\u0651\u0645 \u0643\u064a\u0641\u064a\u0629 \u062a\u0646\u0635\u064a\u0628 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0633\u0627\u0639\u0650\u062f\u0629 \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627"],"Configure":["\u062a\u0643\u0648\u064a\u0646"],"Configure the helper plugin":["\u062a\u0643\u0648\u064a\u0646 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0633\u0627\u0639\u0650\u062f\u0629"],"Activate":["\u062a\u0641\u0639\u064a\u0644"],"Activate the helper plugin":["\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0633\u0627\u0639\u0650\u062f\u0629"],"Install":["\u062a\u0646\u0635\u064a\u0628"],"Install the helper plugin":["\u062a\u0646\u0635\u064a\u0628 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0633\u0627\u0639\u0650\u062f\u0629"],"screen reader text\u0004(opens in a new tab)":["(\u064a\u064f\u0641\u062a\u064e\u062d \u0641\u064a \u062a\u0628\u0648\u064a\u0628 \u062c\u062f\u064a\u062f)"],"Resetting will disconnect all users and remove all Site Kit settings and data within WordPress. <br \/>You and any other users who wish to use Site Kit will need to reconnect to restore access.":["\u0633\u062a\u0624\u062f\u0651\u064a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u064a\u064a\u0646 \u0625\u0644\u0649 \u0641\u0635\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0648\u0625\u0632\u0627\u0644\u0629 \u062c\u0645\u064a\u0639 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u0628\u064a\u0627\u0646\u0627\u062a Site Kit \u062f\u0627\u062e\u0644 WordPress. <br \/>\u0633\u062a\u062d\u062a\u0627\u062c \u0623\u0646\u062a \u0648\u0623\u064a \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0622\u062e\u0631\u064a\u0646 \u064a\u0631\u063a\u0628\u0648\u0646 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 Site Kit \u0625\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0631\u0628\u0637 \u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0648\u0635\u0648\u0644."],"complete module setup\u0004Finish":["\u0625\u0646\u0647\u0627\u0621"],"Source: %s":["\u0627\u0644\u0645\u0635\u062f\u0631: %s"],"Looks like the AMP CDN is restricted in your region, which could interfere with setup on the Site Kit service. <GetHelpLink \/>":["\u064a\u0628\u062f\u0648 \u0623\u0646 \u0634\u0628\u0643\u0629 \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 (CDN) \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0640 AMP \u0645\u0642\u064a\u0651\u062f\u0629 \u0641\u064a \u0645\u0646\u0637\u0642\u062a\u0643\u060c \u0645\u0627 \u0642\u062f \u064a\u062a\u0639\u0627\u0631\u0636 \u0645\u0639 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0641\u064a \u062e\u062f\u0645\u0629 Site Kit. <GetHelpLink \/>"],"To get more help, ask a question on our <a href=\"%1$s\">support forum<\/a> and include the text of the original error message: %2$s":["\u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0625\u0636\u0627\u0641\u064a\u0629\u060c \u0627\u0637\u0631\u062d \u0633\u0624\u0627\u0644\u0627 \u0641\u064a <a href=\"%1$s\">\u0645\u0646\u062a\u062f\u0649 \u0627\u0644\u062f\u0639\u0645<\/a> \u0644\u062f\u064a\u0646\u0627 \u0648\u0623\u0631\u0641\u0642 \u0646\u0635 \u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0623\u0635\u0644\u064a\u0629: %2$s"],"Looks like your site is having a technical issue with requesting data from Google services.":["\u064a\u0628\u062f\u0648 \u0623\u0646 \u0645\u0648\u0642\u0639\u0643 \u064a\u0648\u0627\u062c\u0647 \u0645\u0634\u0643\u0644\u0629 \u062a\u0642\u0646\u064a\u0629 \u0641\u064a \u0637\u0644\u0628 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0646 \u062e\u062f\u0645\u0627\u062a Google."],"Looks like the URL of your site has changed. In order to continue using Site Kit, you\u2019ll need to reconnect, so that your plugin settings are updated with the new URL.":["\u064a\u0628\u062f\u0648 \u0623\u0646 \u0631\u0627\u0628\u0637 \u0645\u0648\u0642\u0639\u0643 \u0642\u062f \u062a\u063a\u064a\u0651\u0631. \u0644\u0645\u0648\u0627\u0635\u0644\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 Site Kit\u060c \u0633\u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0631\u0628\u0637\u060c \u062d\u062a\u0649 \u062a\u064f\u062d\u062f\u064e\u0651\u062b \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0628\u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062c\u062f\u064a\u062f."],"Report this problem":["\u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u0634\u0643\u0644\u0629"],"Site Kit has already been configured by another admin of this site. To use Site Kit as well, sign in with your Google account which has access to Google services for this site (e.g. Google Analytics). Once you complete the 3 setup steps, you\u2019ll see stats from all activated Google services.":["\u0633\u0628\u0642 \u0623\u0646 \u0623\u0639\u062f\u0651 \u0645\u062f\u064a\u0631\u064c \u0622\u062e\u0631 \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 Site Kit. \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Site Kit \u0623\u064a\u0636\u0627\u060c \u0633\u062c\u0651\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0628\u062d\u0633\u0627\u0628 Google \u0627\u0644\u0630\u064a \u064a\u0645\u0644\u0643 \u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u062e\u062f\u0645\u0627\u062a Google \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 (\u0645\u062b\u0644 Google Analytics). \u0628\u0639\u062f \u0625\u0643\u0645\u0627\u0644 \u062e\u0637\u0648\u0627\u062a \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u062b\u0644\u0627\u062b\u060c \u0633\u062a\u0631\u0649 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0645\u0646 \u062c\u0645\u064a\u0639 \u062e\u062f\u0645\u0627\u062a Google \u0627\u0644\u0645\u064f\u0641\u0639\u0651\u0644\u0629."],"Connect your Google account to Site Kit":["\u0627\u0631\u0628\u0637 \u062d\u0633\u0627\u0628 Google \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0628\u0640 Site Kit"],"%1$s To fix this, <a href=\"%2$s\">redo the plugin setup<\/a>.":["%1$s \u0644\u0625\u0635\u0644\u0627\u062d \u0630\u0644\u0643\u060c <a href=\"%2$s\">\u0623\u0639\u062f \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0625\u0636\u0627\u0641\u0629<\/a>."],"Recommended":["\u0645\u0648\u0635\u0649 \u0628\u0647"],"Proceed":["\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629"],"Additional Permissions Required":["\u064a\u0644\u0632\u0645 \u0623\u0630\u0648\u0646\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"],"Verifying\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642\u2026"],"Manage Sites":["\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0648\u0627\u0642\u0639"],"%sK":["%s \u0623\u0644\u0641"],"%sM":["%s \u0645\u0644\u064a\u0648\u0646"],", ":["\u060c "],"Last %s day":["\u0622\u062e\u0631 %s \u064a\u0648\u0645","\u0622\u062e\u0631 %s \u064a\u0648\u0645","\u0622\u062e\u0631 %s \u064a\u0648\u0645","\u0622\u062e\u0631 %s \u064a\u0648\u0645","\u0622\u062e\u0631 %s \u064a\u0648\u0645","\u0622\u062e\u0631 %s \u064a\u0648\u0645"],"Site Kit encountered an error":["\u0648\u0627\u062c\u0647 Site Kit \u062e\u0637\u0623"],"%s (domain property)":["%s (\u062e\u0627\u0635\u064a\u0629 \u0627\u0644\u0646\u0637\u0627\u0642)"],"We found %d existing accounts. Please choose which one to use below.":["\u0648\u062c\u062f\u0646\u0627 %d \u062d\u0633\u0627\u0628\u0627\u062a \u0645\u0648\u062c\u0648\u062f\u0629. \u064a\u0631\u062c\u0649 \u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u064a\u0651\u0647\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0623\u062f\u0646\u0627\u0647."],"Checking Compatibility\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062a\u0648\u0627\u0641\u0642\u2026"],"Your site may not be ready for Site Kit":["\u0642\u062f \u0644\u0627 \u064a\u0643\u0648\u0646 \u0645\u0648\u0642\u0639\u0643 \u062c\u0627\u0647\u0632\u0627 \u0644\u0640 Site Kit"],"Looks like this may be a staging environment and you already have the helper plugin. Before you can use Site Kit, please make sure you\u2019ve provided the necessary credentials in the Authentication section and verified your production site in Search Console. <GetHelpLink \/>":["\u064a\u0628\u062f\u0648 \u0623\u0646 \u0647\u0630\u0647 \u0642\u062f \u062a\u0643\u0648\u0646 \u0628\u064a\u0626\u0629 \u062a\u062c\u0631\u064a\u0628\u064a\u0629 \u0648\u0644\u062f\u064a\u0643 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0633\u0627\u0639\u0650\u062f\u0629 \u0628\u0627\u0644\u0641\u0639\u0644. \u0642\u0628\u0644 \u0623\u0646 \u062a\u062a\u0645\u0643\u0651\u0646 \u0645\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 Site Kit\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0623\u0643\u0651\u062f \u0645\u0646 \u062a\u0642\u062f\u064a\u0645 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0641\u064a \u0642\u0633\u0645 \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0646\u062a\u0627\u062c \u0641\u064a Search Console. <GetHelpLink \/>"],"Looks like this may be a staging environment. If so, you\u2019ll need to install a helper plugin and verify your production site in Search Console. <GetHelpLink \/>":["\u064a\u0628\u062f\u0648 \u0623\u0646 \u0647\u0630\u0647 \u0642\u062f \u062a\u0643\u0648\u0646 \u0628\u064a\u0626\u0629 \u062a\u062c\u0631\u064a\u0628\u064a\u0629. \