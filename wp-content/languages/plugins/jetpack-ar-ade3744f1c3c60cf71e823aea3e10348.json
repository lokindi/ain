062f\u064a\u062f\u0627\u062a \u0627\u0644\u062a\u064a \u0644\u0627 \u064a\u0645\u0643\u0646 \u0645\u0639\u0627\u0644\u062c\u062a\u0647\u0627 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."],"Jetpack Scan can auto-fix %d threat. Continue?":["\u064a\u0645\u0643\u0646 \u0644\u0644\u0623\u062f\u0627\u0629 Jetpack Scan \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f","\u064a\u0645\u0643\u0646 \u0644\u0644\u0623\u062f\u0627\u0629 Jetpack Scan \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f","\u064a\u0645\u0643\u0646 \u0644\u0644\u0623\u062f\u0627\u0629 Jetpack Scan \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f","\u064a\u0645\u0643\u0646 \u0644\u0644\u0623\u062f\u0627\u0629 Jetpack Scan \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f","\u064a\u0645\u0643\u0646 \u0644\u0644\u0623\u062f\u0627\u0629 Jetpack Scan \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f","\u064a\u0645\u0643\u0646 \u0644\u0644\u0623\u062f\u0627\u0629 Jetpack Scan \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f"],"Auto-fix complete":["\u0627\u0643\u062a\u0645\u0644\u062a \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629"],"Fixing threats\u2026":["\u062c\u0627\u0631\u064d \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a\u2026"],"Auto-fix finished: %1$d fixed, %2$d not fixed.":["\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629: \u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%1$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a\u060c \u0648\u062a\u0639\u0630\u0651\u064e\u0631\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%2$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a.","\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629: \u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%1$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a\u060c \u0648\u062a\u0639\u0630\u0651\u064e\u0631\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%2$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a.","\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629: \u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%1$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a\u060c \u0648\u062a\u0639\u0630\u0651\u064e\u0631\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%2$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a.","\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629: \u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%1$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a\u060c \u0648\u062a\u0639\u0630\u0651\u064e\u0631\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%2$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a.","\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629: \u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%1$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a\u060c \u0648\u062a\u0639\u0630\u0651\u064e\u0631\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%2$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a.","\u062a\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629: \u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%1$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a\u060c \u0648\u062a\u0639\u0630\u0651\u064e\u0631\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u2066%2$d\u2069 \u0645\u0646 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a."],"Couldn't check fix status. Please refresh and try again.":["\u062a\u0639\u0630\u0651\u064e\u0631 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u060c \u062b\u0645 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629."],"Auto-fix failed. Please try again.":["\u0641\u0634\u0644\u062a \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629. \u064a\u064f\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629."],"Threat details":["\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062a\u0647\u062f\u064a\u062f"],"Unignore threat":["\u0625\u0644\u063a\u0627\u0621 \u062a\u062c\u0627\u0647\u0644 \u0627\u0644\u062a\u0647\u062f\u064a\u062f"],"Unignore":["\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u062c\u0627\u0647\u0644"],"Ignore threat":["\u062a\u062c\u0627\u0647\u0644 \u0627\u0644\u062a\u0647\u062f\u064a\u062f"],"Fix threat":["\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0647\u062f\u064a\u062f"],"Fixed On":["\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629"],"First Detected":["\u062a\u0627\u0631\u064a\u062e \u0623\u0648\u0644 \u0627\u0643\u062a\u0634\u0627\u0641"],"Signature":["\u0627\u0644\u062a\u0648\u0642\u064a\u0639"],"Severity":["\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062e\u0637\u0648\u0631\u0629"],"Extension":["\u0645\u0644\u062d\u0642"],"History (%d)":["\u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 (%d)"],"Active threats (%d)":["\u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0641\u0639\u0651\u064e\u0644\u0629 (%d)"],"Filter threats by status":["\u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u062d\u0633\u0628 \u0627\u0644\u062d\u0627\u0644\u0629"],"WordPress":["\u0648\u0648\u0631\u062f\u0628\u0631\u064a\u0633"],"Ignored":["\u062a\u0645 \u0627\u0644\u062a\u062c\u0627\u0647\u0644"],"Severity label for issues rated below 3.\u0004Low":["\u0645\u0646\u062e\u0641\u0636 \u0627\u0644\u062e\u0637\u0648\u0631\u0629"],"Severity label for issues rated between 3 and 5.\u0004High":["\u0639\u0627\u0644\u064a \u0627\u0644\u062e\u0637\u0648\u0631\u0629"],"Severity label for issues rated 5 or higher.\u0004Critical":["\u062d\u0631\u062c"],"An auto-fixer is in progress.":["\u0623\u062f\u0627\u0629 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644."],"The auto-fixer is taking longer than expected.":["\u062a\u0633\u062a\u063a\u0631\u0642 \u0623\u062f\u0627\u0629 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0648\u0642\u062a\u064b\u0627 \u0623\u0637\u0648\u0644 \u0645\u0646 \u0627\u0644\u0645\u062a\u0648\u0642\u0639."],"An error occurred auto-fixing this threat.":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u0645\u0639\u0627\u0644\u062c\u0629 \u0647\u0630\u0627 \u0627\u0644\u062a\u0647\u062f\u064a\u062f \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."],"Jetpack will auto-fix the threat.":["\u0633\u062a\u064f\u0639\u0627\u0644\u062c \u0627\u0644\u0625\u0636\u0627\u0641\u0629 Jetpack \u0627\u0644\u062a\u0647\u062f\u064a\u062f \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."],"Replace the default salt keys in wp-config.php with unique ones.":["\u0627\u0633\u062a\u0628\u062f\u0644 \u0645\u0641\u0627\u062a\u064a\u062d Salt \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0641\u064a wp-config.php \u0628\u0645\u0641\u0627\u062a\u064a\u062d \u0641\u0631\u064a\u062f\u0629."],"Replace the infected file with a previously backed up version that is clean.":["\u0627\u0633\u062a\u0628\u062f\u0644 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0645\u062a\u0623\u062b\u0631 \u0628\u0625\u0635\u062f\u0627\u0631 \u0633\u0644\u064a\u0645 \u0645\u0646 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0627\u0644\u0633\u0627\u0628\u0642\u0629."],"Replace the modified core WordPress file with the original clean version from the WordPress source code.":["\u0627\u0633\u06