":["\u062a\u0645 \u0628\u0627\u0644\u0641\u0639\u0644 \u0631\u0628\u0637 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u0628\u0640 Jetpack\u060c \u0644\u0643\u0646 \u0644\u0645 \u064a\u062a\u0645 \u0631\u0628\u0637 \u062d\u0633\u0627\u0628\u0643 \u0628\u062d\u0633\u0627\u0628 \u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0649 WordPress.com \u062d\u062a\u0649 \u0627\u0644\u0622\u0646."],"Link your WordPress.com account":["\u0631\u0628\u0637 \u062d\u0633\u0627\u0628\u0643 \u0628\u0645\u0648\u0642\u0639 WordPress.com"],"Backup needs an active Jetpack connection to show your backup history.":["\u064a\u062a\u0637\u0644\u0628 \u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0639\u0645\u0644\u064a\u0629 \u0631\u0628\u0637 \u0645\u0641\u0639\u0651\u064e\u0644\u0629 \u0628\u0640 Jetpack \u0644\u0639\u0631\u0636 \u0633\u062c\u0644 \u0627\u0644\u0646\u064f\u0633\u062e \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0644\u062f\u064a\u0643."],"Connect Jetpack to get started":["\u0627\u0631\u0628\u0637 \u0645\u0648\u0642\u0639\u0643 \u0628\u0640 Jetpack \u0644\u0628\u062f\u0621 \u0627\u0644\u062a\u0634\u063a\u064a\u0644"],"Add Jetpack Backup to start protecting your site with automatic backups, granular restores, and offsite storage.":["\u0623\u0636\u0641 Jetpack Backup \u0644\u0628\u062f\u0621 \u062d\u0645\u0627\u064a\u0629 \u0645\u0648\u0642\u0639\u0643 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629\u060c \u0648\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u062f\u0642\u064a\u0642\u0629\u060c \u0648\u062a\u062e\u0632\u064a\u0646 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0648\u0642\u0639."],"This site doesn't have an active Backup plan":["\u0644\u0627 \u064a\u062d\u062a\u0648\u064a \u0647\u0630\u0